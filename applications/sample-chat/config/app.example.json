{
  "application": {
    "name": "acme-sample-chat",
    "environment": "local",
    "listen_host": "127.0.0.1",
    "listen_port": 8080
  },
  "backend_model_api": {
    "base_url": "http://127.0.0.1:8000",
    "default_provider": "acme-fast",
    "timeout_seconds": 30
  },
  "prompting": {
    "system_prompt_file": "../prompts/system-chat.txt",
    "default_user_message_file": "../prompts/default-user-message.txt",
    "message_template": "Application context:\n{system_prompt}\n\nUser request:\n{user_message}"
  }
}